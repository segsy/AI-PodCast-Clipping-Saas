GEMINI_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
/////////////////////////////////////////////

# ========= Core =========
ENV=development
API_BASE_URL=http://localhost:8000

# ========= Database (async driver) =========
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME

# ========= Security =========
INNGEST_SERVICE_TOKEN=shared_secret_for_fastapi_start_endpoint
WORKER_CALLBACK_SECRET=replace_with_strong_random
# Optional: sign Modal dispatch payloads too
# WORKER_DISPATCH_SECRET=replace_with_strong_random

# ========= AI Providers =========
GEMINI_API_KEY=your_gemini_key
# Optional if you add more models later:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ========= Orchestration / Modal =========
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret
MODAL_APP_NAME=clippers-worker

# ========= S3 / Object Storage =========
S3_BUCKET=your-bucket
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# ========= Pipeline defaults =========
PIPELINE_VERSION=v1
MIN_CLIP_MS=15000
MAX_CLIP_MS=60000
MAX_CLIPS=12

# ========= Rate limiting / ops (optional) =========
# RATE_LIMIT_RPS=10
# LOG_LEVEL=info